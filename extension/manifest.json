{
  "manifest_version": 3,
  "name": "ContextVolt Exporter",
  "version": "1.1",
  "description": "Send conversations from ChatGPT, Claude, Gemini, Grok, DeepSeek, Perplexity & Copilot to your local ContextVolt.",
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://x.com/i/grok*",
        "https://grok.x.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
