{
  "name": "ContextVolt-context-vault",
  "displayName": "ContextVolt",
  "description": "Browse and inject AI conversation contexts from your local ContextVolt directly in VS Code.",
  "version": "1.0.0",
  "publisher": "ContextVolt",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ContextVolt-vault",
          "title": "ContextVolt",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "ContextVolt-vault": [
        {
          "type": "webview",
          "id": "ContextVolt.sidebarView",
          "name": "Contexts"
        }
      ]
    },
    "commands": [
      {
        "command": "ContextVolt.refreshContexts",
        "title": "ContextVolt: Refresh Contexts",
        "icon": "$(refresh)"
      },
      {
        "command": "ContextVolt.openDashboard",
        "title": "ContextVolt: Open Dashboard"
      }
    ]
  },
  "scripts": {
    "lint": "echo 'no lint configured'"
  }
}
